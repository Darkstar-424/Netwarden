<Window x:Class="NetWarden.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetWarden.UI.ViewModels;assembly=NetWarden.UI"
        xmlns:v="clr-namespace:NetWarden.App.Views"
        Title="NetWarden 1.0.1" Width="1320" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Assets/netwarden.ico"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScopeViewModel}"><v:ScopeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}"><v:ScanView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HostsViewModel}"><v:HostsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FindingsViewModel}"><v:FindingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkMapViewModel}"><v:NetworkMapView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompareViewModel}"><v:CompareView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><v:ReportsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewScanCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="dashboard" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="hosts" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="findings" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="reports" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Background="{DynamicResource Brush.TitleBar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="24" Height="24" Stretch="Uniform" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2"
                          StrokeLineJoin="Round" Data="M12,3 L20,6 L20,12 C20,16.5 16.6,20.2 12,21 C7.4,20.2 4,16.5 4,12 L4,6 Z M8.5,12 L11,14.5 L15.5,9.5" />
                    <TextBlock Text="NetWarden" FontWeight="SemiBold" FontSize="16" Margin="10,0,18,0" VerticalAlignment="Center" />
                    <TextBlock Text="Scope:" VerticalAlignment="Center" Style="{StaticResource Secondary}" Margin="0,0,8,0" />
                    <ComboBox Width="240" ItemsSource="{Binding Workspace.Scopes}" SelectedItem="{Binding Workspace.SelectedScope}" DisplayMemberPath="Name"
                              ToolTip="{Binding Workspace.ScopeSummary}" AutomationProperties.Name="Scope" />
                    <Button Style="{StaticResource LinkButton}" Content="Edit" Margin="10,0,0,0" VerticalAlignment="Center"
                            Command="{Binding NavigateCommand}" CommandParameter="scope" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Brush.SegmentBg}" CornerRadius="8" Padding="3" Margin="0,0,10,0"
                            ToolTip="Simple shows plain-English results and safe presets. Advanced adds every option, raw evidence and filters.">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Mode" Content="Simple" IsChecked="{Binding Workspace.IsSimple, Mode=TwoWay}"
                                         AutomationProperties.Name="Simple mode" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Mode" Content="Advanced" IsChecked="{Binding Workspace.IsAdvanced, Mode=TwoWay}"
                                         AutomationProperties.Name="Advanced mode" />
                        </StackPanel>
                    </Border>
                    <Button Width="36" Padding="0" Margin="0,0,10,0" Command="{Binding ToggleThemeCommand}" ToolTip="Switch light / dark theme" AutomationProperties.Name="Switch theme">
                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Brush.Text}" StrokeThickness="2"
                              Data="M20,14.5 A8,8 0 0 1 9.5,4 A8,8 0 1 0 20,14.5 Z" />
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewScanCommand}" ToolTip="Start a new scan (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource Brush.AccentText}" Data="M0,0 L10,6 L0,12 Z" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="New scan" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border Background="{DynamicResource Brush.Nav}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="10,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="6,8,6,0"
                               Text="Only scan networks you own or are authorized to assess." />
                    <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" AutomationProperties.Name="Navigation">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Tooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="18" Height="18" Stretch="Uniform" Data="{Binding Icon}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="{DynamicResource Brush.Sev.Critical.Solid}" CornerRadius="9" Padding="7,0" MinWidth="18"
                                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />
        </Grid>
    </Grid>
</Window>
