<UserControl x:Class="NetWarden.App.Views.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:NetWarden.UI.Services;assembly=NetWarden.UI">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Style="{StaticResource H1}" Text="Issues" Visibility="{Binding Workspace.IsSimple, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource H1}" Text="Findings" Visibility="{Binding Workspace.IsAdvanced, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Summary}" />
        </StackPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <DockPanel Visibility="{Binding Workspace.IsAdvanced, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Clear filters" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,0" />
                <TextBox Style="{StaticResource MonoBox}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=250}" AutomationProperties.Name="Filter query"
                         ToolTip="Examples: severity>=high · kev:true · host:192.168.1.10 · port:445 · cve:2023 · status:accepted · conf:confirmed · free text" />
            </DockPanel>
            <TextBlock Text="{Binding QueryError}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Visibility="{Binding QueryError, Converter={StaticResource VisibleIf}}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Show" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="150" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" AutomationProperties.Name="Status filter" />
                <TextBlock Text="Severity" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0,8,0" />
                <ComboBox Width="130" ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SeverityFilter}" AutomationProperties.Name="Severity filter" />
                <CheckBox Content="Actively exploited only" IsChecked="{Binding KevOnly}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <ContentControl Style="{StaticResource HelpMark}" ToolTip="{Binding [kev], Source={x:Static svc:Glossary.Instance}}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="470" />
            </Grid.ColumnDefinitions>

            <!-- Simple list -->
            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,16,0" Visibility="{Binding Workspace.IsSimple, Converter={StaticResource BoolToVisibility}}">
                <ListBox Style="{StaticResource SoftList}" ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}" AutomationProperties.Name="Issues">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Style="{StaticResource SevBadge}"><TextBlock Text="{Binding SeverityText}" /></Border>
                                    <Border Style="{StaticResource KevBadge}" Visibility="{Binding Kev, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Actively exploited" /></Border>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Host}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Advanced grid -->
            <DataGrid ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}" Margin="0,0,16,0" AutomationProperties.Name="Findings"
                      Visibility="{Binding Workspace.IsAdvanced, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Severity" Width="110" SortMemberPath="SeverityRank">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SevBadge}"><TextBlock Text="{Binding SeverityText}" /></Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="KEV" Width="50" SortMemberPath="Kev">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="KEV" FontWeight="Bold" Foreground="{DynamicResource Brush.Danger}" Visibility="{Binding Kev, Converter={StaticResource BoolToVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="2*" />
                    <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*" />
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="75" />
                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="105" />
                    <DataGridTextColumn Header="CVSS" Binding="{Binding Cvss}" Width="55" SortMemberPath="CvssValue" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="105" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Detail -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <TextBlock Style="{StaticResource Secondary}" Margin="18" Text="Select an issue to see what it means and how to fix it."
                               Visibility="{Binding HasSelection, Converter={StaticResource CollapsedIf}}" />
                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,12">
                            <WrapPanel>
                                <Button Style="{StaticResource PrimaryButton}" Content="Mark fixed" Command="{Binding MarkFixedCommand}" Margin="0,0,8,6"
                                        ToolTip="It will re-open automatically if a later scan finds it again." />
                                <Button Content="Accept risk…" Command="{Binding AcceptRiskCommand}" Margin="0,0,8,6" ToolTip="{Binding [accepted risk], Source={x:Static svc:Glossary.Instance}}" />
                                <Button Content="False positive…" Command="{Binding FalsePositiveCommand}" Margin="0,0,8,6" ToolTip="{Binding [false positive], Source={x:Static svc:Glossary.Instance}}" />
                                <Button Content="Re-open" Command="{Binding ReopenCommand}" Margin="0,0,8,6" />
                                <Button Style="{StaticResource LinkButton}" Content="Copy fix steps" Command="{Binding CopyStepsCommand}" VerticalAlignment="Center" Margin="4,0,0,6" />
                            </WrapPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,16" DataContext="{Binding SelectedFinding}">
                                <WrapPanel Margin="0,0,0,8">
                                    <Border Style="{StaticResource SevBadge}"><TextBlock Text="{Binding SeverityText}" /></Border>
                                    <Border Style="{StaticResource KevBadge}" Visibility="{Binding Kev, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Actively exploited (KEV)" /></Border>
                                    <Border Style="{StaticResource OutlineBadge}" ToolTip="{Binding [confidence], Source={x:Static svc:Glossary.Instance}}"><TextBlock Text="{Binding Confidence}" /></Border>
                                    <Border Style="{StaticResource OutlineBadge}" Visibility="{Binding Cvss, Converter={StaticResource VisibleIf}}" ToolTip="{Binding [cvss], Source={x:Static svc:Glossary.Instance}}">
                                        <TextBlock><Run Text="CVSS " /><Run Text="{Binding Cvss, Mode=OneWay}" /></TextBlock>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0">
                                    <Run Text="{Binding Host, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Port, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding StatusText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusNote}" Visibility="{Binding StatusNote, Converter={StaticResource VisibleIf}}" Margin="0,2,0,0" />

                                <TextBlock Style="{StaticResource Label}" Text="WHAT IT MEANS" Margin="0,16,0,4" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="21" />

                                <TextBlock Style="{StaticResource Label}" Text="HOW TO FIX" Margin="0,16,0,4" />
                                <TextBox Style="{StaticResource SelectableText}" FontFamily="{StaticResource Font.Ui}" FontSize="14"
                                         Text="{Binding Remediation, Mode=OneWay, Converter={StaticResource NumberedLines}}" />

                                <TextBlock Style="{StaticResource Label}" Text="EVIDENCE" Margin="0,16,0,4" />
                                <Border Style="{StaticResource CodeBox}">
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Evidence, Mode=OneWay}" />
                                </Border>

                                <StackPanel Visibility="{Binding Cves, Converter={StaticResource VisibleIf}}">
                                    <TextBlock Style="{StaticResource Label}" Text="CVE" Margin="0,16,0,4" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Cves, Mode=OneWay}" />
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding CvssVector, Mode=OneWay}" Margin="0,2,0,0" FontSize="11.5" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Label}" Text="REFERENCES" Margin="0,16,0,4" Visibility="{Binding References.Count, Converter={StaticResource VisibleIf}}" />
                                <ItemsControl ItemsSource="{Binding References}" Style="{StaticResource PlainList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LinkButton}" Content="{Binding}" Margin="0,0,0,4" FontSize="12.5"
                                                    Command="{Binding DataContext.OpenReferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
