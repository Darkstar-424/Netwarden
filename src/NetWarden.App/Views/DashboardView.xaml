<UserControl x:Class="NetWarden.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NetWarden.App.Controls"
             xmlns:svc="clr-namespace:NetWarden.UI.Services;assembly=NetWarden.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,28" MaxWidth="1180" HorizontalAlignment="Left">

            <!-- ======================= SIMPLE MODE ======================= -->
            <StackPanel Visibility="{Binding Workspace.IsSimple, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource H1}" Text="Your network at a glance" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding LastScanText}" Margin="0,4,0,20"
                           Visibility="{Binding LastScanText, Converter={StaticResource VisibleIf}}" />

                <!-- First run / no scan yet -->
                <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,0,20" Visibility="{Binding NoScan, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="{Binding Headline}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding SubHeadline}" Margin="0,6,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="Set up what to check" Command="{Binding SetupScopeCommand}"
                                    Visibility="{Binding Workspace.HasScope, Converter={StaticResource CollapsedIf}}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Run a quick health check" Command="{Binding RunScanCommand}"
                                    Visibility="{Binding Workspace.HasScope, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0"
                                   Text="NetWarden only reads what devices share openly. It never changes settings, tries passwords or exploits anything." />
                    </StackPanel>
                </Border>

                <!-- Attention banner -->
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,22" Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="52" Height="52" Margin="0,0,18,0" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource Brush.Sev.High.Bg}" Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                            <Ellipse Fill="{DynamicResource Brush.Success.Bg}" Visibility="{Binding AllClear, Converter={StaticResource BoolToVisibility}}" />
                            <Path Width="26" Height="26" Stretch="Uniform" Stroke="{DynamicResource Brush.Sev.High.Fg}" StrokeThickness="2" StrokeLineJoin="Round"
                                  Data="M12,3 L21,19 L3,19 Z M12,10 L12,14 M12,16.5 L12,17" Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                            <Path Width="24" Height="24" Stretch="Uniform" Stroke="{DynamicResource Brush.Success}" StrokeThickness="2.5" StrokeLineJoin="Round"
                                  Data="M4,12 L10,18 L20,6" Visibility="{Binding AllClear, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource H2}" Text="{Binding Headline}" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding SubHeadline}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Check again" Command="{Binding RunScanCommand}" Margin="0,0,10,0" />
                            <Button Content="Get a report" Command="{Binding OpenReportsCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Fix these first -->
                <StackPanel Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource H2}" Text="Fix these first" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,12"
                               Text="Sorted by risk. Each item is one action that can fix several issues at once." />
                    <ItemsControl ItemsSource="{Binding FixItems}" Style="{StaticResource PlainList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="20,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Brush.Text}" VerticalAlignment="Top" Margin="0,2,16,0">
                                            <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Brush.Surface}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Style="{StaticResource SevBadge}"><TextBlock Text="{Binding SeverityText}" /></Border>
                                                <Border Style="{StaticResource KevBadge}" Visibility="{Binding Kev, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Actively exploited" /></Border>
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding CountText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource H3}" Text="{Binding Action}" />
                                            <TextBlock Text="{Binding Why}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding AppliesTo}" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Show me how" VerticalAlignment="Center" Margin="16,0,0,0"
                                                Command="{Binding DataContext.ShowFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource LinkButton}" Content="See every issue →" Command="{Binding OpenFindingsCommand}" Margin="4,2,0,22" />
                </StackPanel>

                <!-- Summary cards -->
                <UniformGrid Columns="3" Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" Text="Devices found" />
                            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Devices}" />
                            <Button Style="{StaticResource LinkButton}" Content="See all devices" Command="{Binding OpenHostsCommand}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="4,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Secondary}" Text="Services running" />
                                <ContentControl Style="{StaticResource HelpMark}" ToolTip="{Binding [service], Source={x:Static svc:Glossary.Instance}}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Services}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding PortsDelta}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" Text="Issues found" />
                            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Issues}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SeverityBreakdown}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- ======================= ADVANCED MODE ======================= -->
            <StackPanel Visibility="{Binding Workspace.IsAdvanced, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Compare scans" Command="{Binding CompareCommand}" Margin="0,0,8,0" />
                        <Button Content="Reports" Command="{Binding OpenReportsCommand}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="Dashboard" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding Workspace.CurrentScanLabel}" />
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding NoScan, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3}" Text="No scans yet" />
                        <TextBlock Style="{StaticResource Secondary}" Text="Define a scope, then start a scan (Ctrl+N). You can also import Nmap XML from the Reports page." Margin="0,4,0,10" />
                        <Button Style="{StaticResource PrimaryButton}" Content="New scan" Command="{Binding RunScanCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Hosts up" />
                            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Devices}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding HostsDelta}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="3,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Open ports" />
                            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Services}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding PortsDelta}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="3,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Open findings" />
                            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Issues}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding FindingsDelta}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Caption}" Text="KEV-listed" />
                                <ContentControl Style="{StaticResource HelpMark}" ToolTip="{Binding [kev], Source={x:Static svc:Glossary.Instance}}" />
                            </StackPanel>
                            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding KevCount}" Foreground="{DynamicResource Brush.Danger}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding KevText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="Findings by severity" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <c:DonutChart Width="150" Height="150" Critical="{Binding Critical}" High="{Binding High}" Medium="{Binding Medium}" Low="{Binding Low}" />
                                <ItemsControl ItemsSource="{Binding Slices}" Margin="28,0,0,0" VerticalAlignment="Center" Style="{StaticResource PlainList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3" MinWidth="150">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource SevBadge}"><TextBlock Text="{Binding Label}" /></Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="Open findings over time (this scope)" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Trend}" Height="176" Style="{StaticResource PlainList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="6,0">
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            <StackPanel VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Value}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                <Border x:Name="Bar" Height="{Binding Height}" CornerRadius="3,3,0,0" Background="{DynamicResource Brush.Bar}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3}" Text="Scan history" Margin="16,14,16,10" />
                        <DataGrid ItemsSource="{Binding Workspace.Scans}" BorderThickness="0,1,0,0" MaxHeight="360" x:Name="History"
                                  MouseDoubleClick="History_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Started" Binding="{Binding Started, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                                <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="*" />
                                <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="*" />
                                <DataGridTextColumn Header="Hosts" Binding="{Binding HostsUp}" Width="70" />
                                <DataGridTextColumn Header="Ports" Binding="{Binding OpenPorts}" Width="70" />
                                <DataGridTextColumn Header="Crit" Binding="{Binding Critical}" Width="55" />
                                <DataGridTextColumn Header="High" Binding="{Binding High}" Width="55" />
                                <DataGridTextColumn Header="Med" Binding="{Binding Medium}" Width="55" />
                                <DataGridTextColumn Header="Low" Binding="{Binding Low}" Width="55" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="95" />
                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LinkButton}" Content="Open"
                                                    Command="{Binding DataContext.OpenScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
