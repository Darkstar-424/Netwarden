<UserControl x:Class="NetWarden.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:NetWarden.UI.Services;assembly=NetWarden.UI">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" MinWidth="130" Margin="0,0,8,0"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="11" Height="12" Stretch="Uniform" Fill="{DynamicResource Brush.AccentText}" Data="M0,0 L10,6 L0,12 Z" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Start scan" />
                    </StackPanel>
                </Button>
                <Button Content="Pause" Command="{Binding PauseCommand}" Margin="0,0,8,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Resume" Command="{Binding ResumeCommand}" Margin="0,0,8,0" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Run a check" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding ScopeText}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource LinkButton}" Content="Change" Command="{Binding EditScopeCommand}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: what kind of check -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,20,0" IsEnabled="{Binding IsIdle}">
                <StackPanel>
                    <Border Style="{StaticResource WarningBox}" Margin="0,0,0,12" Visibility="{Binding CanStartText, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="{Binding CanStartText}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Style="{StaticResource Label}" Text="WHAT DO YOU WANT TO DO?" />
                    <ListBox Style="{StaticResource SoftList}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Background="{DynamicResource Brush.Surface}"
                             BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4" AutomationProperties.Name="Scan type">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,2">
                                    <TextBlock Text="{Binding Goal}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Advanced profile editor -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding Workspace.IsAdvanced, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="Profile settings" Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource Label}" Text="TCP PORTS (top100, top1000, all, or 22,80,8000-8100)" />
                            <TextBox Style="{StaticResource MonoBox}" Text="{Binding Ports, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ports" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding PortCountText}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding PortsError}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Visibility="{Binding PortsError, Converter={StaticResource VisibleIf}}" />

                            <TextBlock Style="{StaticResource Label}" Text="SPEED" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding TimingOptions}" SelectedItem="{Binding Timing}" ToolTip="{Binding [polite], Source={x:Static svc:Glossary.Instance}}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding TimingText}" Margin="0,3,0,0" />
                            <UniformGrid Columns="3" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource Label}" Text="MAX CONNECTIONS" />
                                    <TextBox Text="{Binding MaxConcurrency, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="3,0">
                                    <TextBlock Style="{StaticResource Label}" Text="TIMEOUT (MS)" />
                                    <TextBox Text="{Binding TimeoutMs, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Style="{StaticResource Label}" Text="MAX PER SECOND" />
                                    <TextBox Text="{Binding MaxRate, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Style="{StaticResource Label}" Text="DISCOVERY" Margin="0,14,0,6" />
                            <CheckBox Content="ICMP ping" IsChecked="{Binding IcmpPing}" Margin="0,0,0,6" />
                            <CheckBox Content="TCP ping (common ports)" IsChecked="{Binding TcpPing}" Margin="0,0,0,6" />
                            <CheckBox Content="Treat every address as up (slower; for firewalled hosts)" IsChecked="{Binding AssumeUp}" Margin="0,0,0,6" />

                            <TextBlock Style="{StaticResource Label}" Text="DETECTION" Margin="0,10,0,6" />
                            <CheckBox Content="UDP probes (DNS, NTP, NetBIOS, SNMPv3, IPMI, SSDP)" IsChecked="{Binding UdpProbes}" Margin="0,0,0,6" />
                            <CheckBox Content="Service and version detection" IsChecked="{Binding ServiceDetection}" Margin="0,0,0,6" />
                            <CheckBox Content="TLS inspection (versions, ciphers, certificates)" IsChecked="{Binding TlsInspection}" Margin="0,0,0,6" />
                            <CheckBox Content="OS fingerprinting" IsChecked="{Binding OsDetection}" Margin="0,0,0,6" />
                            <CheckBox IsChecked="{Binding IdentifyApps}" Margin="0,0,0,6"
                                      ToolTip="Recognises web apps and admin pages, asks devices what they advertise over Bonjour, and reads their UPnP model description. Read-only; uses the same discovery your phone and printer dialogs use.">
                                <TextBlock Text="Identify apps and device models (web apps, Bonjour, UPnP)" TextWrapping="Wrap" />
                            </CheckBox>

                            <TextBlock Style="{StaticResource Label}" Text="VULNERABILITY ASSESSMENT" Margin="0,10,0,6" />
                            <CheckBox Content="Vulnerability checks" IsChecked="{Binding VulnerabilityChecks}" Margin="0,0,0,6" />
                            <CheckBox IsChecked="{Binding SafeProbes}" Margin="0,0,0,6" ToolTip="{Binding [safe probe], Source={x:Static svc:Glossary.Instance}}">
                                <TextBlock Text="Safe probes (read-only requests that confirm a weakness)" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding AnonymousChecks}" Margin="0,0,0,6"
                                      ToolTip="Logs in as 'anonymous' once (FTP) or opens an anonymous Windows session (MS17-010 check). No passwords are ever guessed.">
                                <TextBlock Text="Anonymous-login checks (anonymous FTP, MS17-010). Off by default." TextWrapping="Wrap" />
                            </CheckBox>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Save as profile…" Command="{Binding SaveProfileCommand}" Margin="0,0,8,8" />
                                <Button Content="Import…" Command="{Binding ImportProfileCommand}" Margin="0,0,8,8" />
                                <Button Content="Export…" Command="{Binding ExportProfileCommand}" Margin="0,0,8,8" />
                                <Button Content="Delete" Command="{Binding DeleteProfileCommand}" Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Label}" Text="SAME SCAN FROM THE COMMAND LINE" Margin="0,8,0,4" />
                            <Border Style="{StaticResource CodeBox}">
                                <TextBox Style="{StaticResource SelectableText}" Text="{Binding CliCommand, Mode=OneWay}" />
                            </Border>
                            <Button Style="{StaticResource LinkButton}" Content="Copy" Command="{Binding CopyCliCommand}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: live progress -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Secondary}" Text="{Binding Eta}" />
                            <TextBlock Style="{StaticResource H3}" Text="{Binding Phase, TargetNullValue='Ready'}" />
                        </DockPanel>
                        <ProgressBar Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,10,0,8" AutomationProperties.Name="Scan progress" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Counts}" Margin="0,4,0,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="See the results →" Command="{Binding ViewResultsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Visibility="{Binding HasFinished, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <TabControl Grid.Row="1">
                    <TabItem Header="Devices">
                        <DataGrid ItemsSource="{Binding LiveHosts}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="130" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="OS guess" Binding="{Binding Os}" Width="*" />
                                <DataGridTextColumn Header="Open ports" Binding="{Binding OpenPorts}" Width="*" />
                                <DataGridTextColumn Header="Issues" Binding="{Binding FindingCount}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Findings">
                        <DataGrid ItemsSource="{Binding LiveFindings}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Severity" Width="115" SortMemberPath="SeverityRank">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SevBadge}"><TextBlock Text="{Binding SeverityText}" /></Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*" />
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Activity log">
                        <Border Style="{StaticResource Card}" Padding="8">
                            <ListBox ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.Text}"
                                     FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                        </Border>
                    </TabItem>
                </TabControl>

                <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,10,0,0"
                           Text="Default speed is 'Polite': few connections at once so fragile devices aren't disturbed. Every scan is recorded in the audit log." />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
