<UserControl x:Class="NetWarden.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:NetWarden.UI.Services;assembly=NetWarden.UI">
    <DockPanel Margin="28,24,28,24">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="Settings" />
        <TabControl>
            <!-- General -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Appearance" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Theme" VerticalAlignment="Center" Width="120" />
                                    <ComboBox Width="200" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" AutomationProperties.Name="Theme" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="120,4,0,0" Text="System follows your Windows light/dark setting." />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="Mode" VerticalAlignment="Center" Width="120" />
                                    <CheckBox Content="Advanced mode (all options, raw evidence, query filters)" IsChecked="{Binding Workspace.IsAdvanced}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Data folder" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource SelectableText}" Text="{Binding DataFolder, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding DataFolderNote}" Margin="0,6,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                                    <Button Content="Open log files" Command="{Binding OpenLogsCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="MAC vendor list" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,10"
                                           Text="NetWarden includes common vendors. For full coverage, download oui.csv from standards-oui.ieee.org and import it here." />
                                <Button Content="Import oui.csv…" Command="{Binding ImportOuiCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- CVE database -->
            <TabItem Header="Vulnerability database">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource H3}" Text="CVE database (NVD + CISA KEV)" />
                                    <ContentControl Style="{StaticResource HelpMark}" ToolTip="{Binding [cve], Source={x:Static svc:Glossary.Instance}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding CveStatus}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <TextBlock Style="{StaticResource Label}" Text="NVD API KEY (OPTIONAL, FREE – MAKES THE FIRST DOWNLOAD ~10× FASTER)" />
                                <TextBox Text="{Binding NvdApiKey, UpdateSourceTrigger=LostFocus}" Width="420" HorizontalAlignment="Left" Style="{StaticResource MonoBox}" />
                                <Button Style="{StaticResource LinkButton}" Content="Get a free key from nvd.nist.gov" Margin="0,4,0,12"
                                        Command="{Binding OpenNvdKeyPageCommand}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Download / update now" Command="{Binding UpdateCveCommand}" Margin="0,0,8,0" />
                                    <Button Content="Cancel" Command="{Binding CancelUpdateCommand}" />
                                </StackPanel>
                                <ProgressBar Maximum="1" Value="{Binding CveFraction, Mode=OneWay}" Margin="0,12,0,6" Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding CveProgress}" Style="{StaticResource Secondary}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                           Text="Downloads only from services.nvd.nist.gov and www.cisa.gov over verified HTTPS. Responses are checked for the expected format before anything is stored." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Offline (air-gapped) updates" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,10"
                                           Text="Export a bundle on a PC with internet access, copy it across, and import it here. Bundles carry a SHA-256 fingerprint that is checked before import." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Export bundle…" Command="{Binding ExportBundleCommand}" Margin="0,0,8,0" />
                                    <Button Content="Import bundle…" Command="{Binding ImportBundleCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Schedules -->
            <TabItem Header="Scheduled scans">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="New scheduled scan" Margin="0,0,0,10" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Label}" Text="NAME" />
                                    <TextBox Width="200" Text="{Binding ScheduleName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Label}" Text="SCOPE (AUTHORIZED ONLY)" />
                                    <ComboBox Width="200" ItemsSource="{Binding ScheduleScopes}" SelectedItem="{Binding ScheduleScope}" DisplayMemberPath="Name" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Label}" Text="PROFILE" />
                                    <ComboBox Width="200" ItemsSource="{Binding ScheduleProfiles}" SelectedItem="{Binding ScheduleProfile}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Label}" Text="HOW OFTEN" />
                                    <ComboBox Width="120" ItemsSource="{Binding FrequencyOptions}" SelectedItem="{Binding Frequency}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Label}" Text="DAY (WEEKLY)" />
                                    <ComboBox Width="130" ItemsSource="{Binding DayOptions}" SelectedItem="{Binding Day}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Label}" Text="TIME (HH:MM)" />
                                    <TextBox Width="80" Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </WrapPanel>
                            <CheckBox Content="Send a notification when new serious issues are found" IsChecked="{Binding ScheduleNotify}" Margin="0,4,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Create schedule" Command="{Binding AddScheduleCommand}" Margin="0,0,8,0" />
                                <Button Content="Refresh" Command="{Binding RefreshSchedulesCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ScheduleStatus}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Text="Schedules use Windows Task Scheduler under your account (no admin needed) and run while you're signed in." />
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Schedules}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="*" />
                            <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="*" />
                            <DataGridTextColumn Header="Next run" Binding="{Binding NextRun}" Width="170" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTemplateColumn Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource LinkButton}" Content="Delete"
                                                Command="{Binding DataContext.DeleteScheduleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Notifications -->
            <TabItem Header="Notifications">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <CheckBox Content="Notify me when a scan finds new issues" IsChecked="{Binding NotificationsEnabled}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="26,8,0,14">
                                <TextBlock Text="Minimum severity" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="130" ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding MinimumSeverity}" />
                                <TextBlock Style="{StaticResource Caption}" Text="Actively exploited (KEV) issues always notify." VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource H3}" Text="Email" Margin="0,4,0,8" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Label}" Text="SMTP SERVER" />
                                    <TextBox Width="240" Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Label}" Text="PORT" />
                                    <TextBox Width="80" Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <CheckBox Content="Use TLS (STARTTLS)" IsChecked="{Binding SmtpStartTls}" VerticalAlignment="Bottom" Margin="0,0,12,16" />
                            </WrapPanel>
                            <WrapPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Label}" Text="USER NAME (OPTIONAL)" />
                                    <TextBox Width="240" Text="{Binding SmtpUser, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Label}" Text="PASSWORD" />
                                    <PasswordBox x:Name="SmtpPasswordBox" Width="240" PasswordChanged="SmtpPasswordBox_PasswordChanged" />
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Label}" Text="FROM" />
                                    <TextBox Width="240" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Style="{StaticResource Label}" Text="TO (SEPARATE WITH ;)" />
                                    <TextBox Width="320" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Style="{StaticResource H3}" Text="Microsoft Teams" Margin="0,12,0,8" />
                            <CheckBox Content="Post to a Teams channel" IsChecked="{Binding UseTeams}" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource Label}" Text="WORKFLOWS WEBHOOK URL" />
                            <PasswordBox x:Name="TeamsWebhookBox" Width="560" HorizontalAlignment="Left" PasswordChanged="TeamsWebhookBox_PasswordChanged" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Text="In Teams: channel ••• › Workflows › 'Post to a channel when a webhook request is received'. Paste the URL here." />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveNotificationsCommand}" Margin="0,0,8,0" MinWidth="90" />
                                <Button Content="Send test" Command="{Binding TestNotificationCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding NotificationStatus}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Audit -->
            <TabItem Header="Audit log">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshAuditCommand}" />
                        <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center"
                                   Text="Every scope authorization, scan, status change and export. Entries can't be edited or deleted." />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Audit}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150" />
                            <DataGridTextColumn Header="Who" Binding="{Binding User}" Width="150" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="140" />
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="140" />
                            <DataGridTextColumn Header="Targets" Binding="{Binding Targets}" Width="*" />
                            <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="130" />
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Checks -->
            <TabItem Header="Checks">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="All vulnerability checks are non-intrusive: they read versions and settings, or send harmless read-only requests. None exploit, brute-force or change anything. Extra web checks can be added as JSON packs (with a .sha256 file) in the data folder's 'checks' directory." />
                    <DataGrid ItemsSource="{Binding Checks}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                            <DataGridTextColumn Header="How it works" Binding="{Binding LevelText}" Width="*" />
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- About -->
            <TabItem Header="About">
                <Border Style="{StaticResource Card}" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}">
                            <Run Text="NetWarden " /><Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Secondary}" Text="Defensive network discovery and vulnerability assessment for networks you own or are authorized to assess." Margin="0,4,0,12" />
                        <TextBlock Style="{StaticResource H3}" Text="Responsible use" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ResponsibleUse}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="No telemetry: NetWarden never sends data anywhere except the NVD/CISA feeds you choose to download and the notification channels you configure." />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
