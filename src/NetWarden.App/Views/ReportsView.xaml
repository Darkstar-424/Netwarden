<UserControl x:Class="NetWarden.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Reports" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,18"
                       Text="Save a report to share with your team or management, or import results from Nmap to check them for known weaknesses." />

            <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Create a report" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource Label}" Text="SCAN" />
                    <ComboBox ItemsSource="{Binding Workspace.Scans}" SelectedItem="{Binding SelectedScan}" DisplayMemberPath="Label" Margin="0,0,0,12" AutomationProperties.Name="Scan" />
                    <TextBlock Style="{StaticResource Label}" Text="TITLE" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                    <UniformGrid Columns="4">
                        <Button Margin="0,0,8,0" Command="{Binding ExportCommand}" CommandParameter="pdf" MinHeight="70">
                            <StackPanel>
                                <TextBlock Text="PDF" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Executive summary + detail" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="4,0" Command="{Binding ExportCommand}" CommandParameter="html" MinHeight="70">
                            <StackPanel>
                                <TextBlock Text="Web page (HTML)" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Opens in any browser" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="4,0" Command="{Binding ExportCommand}" CommandParameter="csv" MinHeight="70">
                            <StackPanel>
                                <TextBlock Text="Spreadsheet (CSV)" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Findings + devices" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Command="{Binding ExportCommand}" CommandParameter="json" MinHeight="70">
                            <StackPanel>
                                <TextBlock Text="JSON" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Full data for other tools" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <TextBlock Text="{Binding Status}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="Open reports folder" Command="{Binding OpenReportsFolderCommand}" Margin="0,0,18,0" />
                        <Button Style="{StaticResource LinkButton}" Content="Show this scan on the dashboard" Command="{Binding ShowScanCommand}" Margin="0,0,18,0" />
                        <Button Style="{StaticResource LinkButton}" Content="Delete this scan" Command="{Binding DeleteScanCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Import Nmap results" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,12"
                               Text="Load an Nmap XML file (nmap -sV -oX results.xml …). NetWarden matches the detected versions against its CVE database and runs its configuration checks. Nothing is sent over the network during import." />
                    <Button Style="{StaticResource PrimaryButton}" Content="Import Nmap XML…" Command="{Binding ImportNmapCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
