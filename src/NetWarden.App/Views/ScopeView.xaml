<UserControl x:Class="NetWarden.App.Views.ScopeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:NetWarden.UI.Services;assembly=NetWarden.UI">
    <Grid Margin="28,24,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Saved scopes -->
        <DockPanel Margin="0,0,20,0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Scopes" Margin="0,0,0,4" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="A scope is a list of devices you're allowed to check." Margin="0,0,0,12" />
            <Button DockPanel.Dock="Bottom" Content="+ New scope" Command="{Binding NewCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
            <Border Style="{StaticResource Card}" Padding="4">
                <ListBox Style="{StaticResource SoftList}" ItemsSource="{Binding Workspace.Scopes}" SelectedItem="{Binding SelectedScope}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Targets}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxHeight="18" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <!-- Editor -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource H1}" Text="What should NetWarden check?" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,18"
                           Text="Pick the devices to look at. NetWarden only reads what they share openly. It never changes settings, tries passwords or exploits anything." />

                <Border Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <!-- Detected networks -->
                        <StackPanel Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,18">
                            <TextBlock Style="{StaticResource Label}" Text="NETWORKS THIS PC IS CONNECTED TO" />
                            <ItemsControl ItemsSource="{Binding Suggestions}" Style="{StaticResource PlainList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Margin="0,0,8,8" ToolTip="Use this network as the target"
                                                Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Label}" Text="NAME" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" AutomationProperties.Name="Scope name" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Label}" Text="ADDRESSES TO CHECK" />
                                    <ContentControl Style="{StaticResource HelpMark}" Margin="6,0,0,4" ToolTip="{Binding [cidr], Source={x:Static svc:Glossary.Instance}}" />
                                </StackPanel>
                                <TextBox Style="{StaticResource MultiLineBox}" Height="120" Text="{Binding Targets, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Targets" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="One per line: 192.168.1.10 · 192.168.1.0/24 · 10.0.0.1-10.0.0.50 · 10.0.0.1-50 · nas.local" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="{Binding AddressSummary}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Label}" Text="SKIP THESE DEVICES (OPTIONAL)" />
                                    <ContentControl Style="{StaticResource HelpMark}" Margin="6,0,0,4" ToolTip="{Binding [exclusions], Source={x:Static svc:Glossary.Instance}}" />
                                </StackPanel>
                                <TextBox Style="{StaticResource MultiLineBox}" Height="120" Text="{Binding Exclusions, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Exclusions" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Useful for old printers, medical or factory equipment that may not cope with being checked." />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource WarningBox}" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ValidationError}" TextWrapping="Wrap" />
                        </Border>

                        <Border Style="{StaticResource WarningBox}" Margin="0,16,0,0" Visibility="{Binding HasPublicTargets, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Public internet address" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PublicWarning}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <CheckBox IsChecked="{Binding PublicAcknowledged}" Foreground="{DynamicResource Brush.Warning.Fg}">
                                    <TextBlock Text="I own these public addresses or have written permission to test them." TextWrapping="Wrap" />
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Label}" Text="NOTES (OPTIONAL)" Margin="0,16,0,4" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Notes" />

                        <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,20,0,0">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding Authorized}" AutomationProperties.Name="I am authorized to scan these assets">
                                    <StackPanel>
                                        <TextBlock Text="I own these devices or am authorized to scan them." FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0"
                                                   Text="Scanning networks you don't control can be illegal. NetWarden records who confirmed this, and every scan that is run, in its audit log." />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding AuthorizationRecord}" Margin="26,6,0,0"
                                           Visibility="{Binding AuthorizationRecord, Converter={StaticResource VisibleIf}}" />
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,20,0,0">
                            <Button DockPanel.Dock="Left" Content="Delete scope" Command="{Binding DeleteCommand}" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,10,0" MinWidth="90" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Save and choose a check →" Command="{Binding ScanNowCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SaveHint}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
