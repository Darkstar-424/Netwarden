<UserControl x:Class="NetWarden.App.Views.HostsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:NetWarden.UI.Services;assembly=NetWarden.UI">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <TextBox DockPanel.Dock="Right" Width="300" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                     ToolTip="Filter by address, name, OS, vendor, service or port number" AutomationProperties.Name="Filter devices" />
            <TextBlock DockPanel.Dock="Right" Text="Filter" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Devices" Visibility="{Binding Workspace.IsSimple, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource H1}" Text="Hosts" Visibility="{Binding Workspace.IsAdvanced, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Summary}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" Margin="0,0,16,0" AutomationProperties.Name="Devices">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="125" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="OS guess" Binding="{Binding Os}" Width="*" />
                    <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="*" />
                    <DataGridTextColumn Header="Apps and services" Binding="{Binding AppSummary}" Width="1.4*" />
                    <DataGridTextColumn Header="Ports" Binding="{Binding OpenPortCount}" Width="60" />
                    <DataGridTemplateColumn Header="Worst issue" Width="120" SortMemberPath="WorstRank">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SevBadge}"><TextBlock Text="{Binding WorstSeverityText}" /></Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Issues" Binding="{Binding FindingCount}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Host detail -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <TextBlock Style="{StaticResource Secondary}" Text="Select a device to see its details." Margin="18"
                               Visibility="{Binding HasSelection, Converter={StaticResource CollapsedIf}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="18,16" DataContext="{Binding SelectedHost}">
                            <TextBlock Style="{StaticResource H2}" Text="{Binding Address}" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Name}" Visibility="{Binding Name, Converter={StaticResource VisibleIf}}" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource Secondary}" Text="OS guess" />
                                    <ContentControl Style="{StaticResource HelpMark}" ToolTip="{Binding [os guess], Source={x:Static svc:Glossary.Instance}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OsDetail}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource Secondary}" Text="MAC" />
                                    <ContentControl Style="{StaticResource HelpMark}" ToolTip="{Binding [mac], Source={x:Static svc:Glossary.Instance}}" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Mac}" Style="{StaticResource Mono}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Style="{StaticResource Secondary}" Text="Vendor" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Vendor}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="3" Style="{StaticResource Secondary}" Text="Found by" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Discovery}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="4" Style="{StaticResource Secondary}" Text="Response time" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Latency}" />
                                <TextBlock Grid.Row="5" Style="{StaticResource Secondary}" Text="Device" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DeviceDetail}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </Grid>

                            <StackPanel Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
                                    <TextBlock Style="{StaticResource H3}" Text="Apps and services" />
                                    <ContentControl Style="{StaticResource HelpMark}"
                                                    ToolTip="What NetWarden recognised on this device: web apps and admin pages, services it advertises over Bonjour, and its UPnP description. Identified without signing in." />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Apps}" Style="{StaticResource PlainList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Where}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                                        <Run Text="{Binding Category, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
                                <TextBlock Style="{StaticResource H3}" Text="Open ports" />
                                <ContentControl Style="{StaticResource HelpMark}" ToolTip="{Binding [port], Source={x:Static svc:Glossary.Instance}}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Ports}" Style="{StaticResource PlainList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Port}" Style="{StaticResource Mono}" FontWeight="SemiBold" Width="80" />
                                                    <TextBlock Text="{Binding Service}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Product}" Style="{StaticResource Secondary}" Margin="8,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Banner}" Style="{StaticResource Caption}" Margin="80,2,0,0" Visibility="{Binding Banner, Converter={StaticResource VisibleIf}}" />
                                                <TextBlock Style="{StaticResource Caption}" Margin="80,2,0,0" Visibility="{Binding Tls, Converter={StaticResource VisibleIf}}">
                                                    <Run Text="TLS: " /><Run Text="{Binding Tls, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Caption}" Margin="80,2,0,0" Text="{Binding Certificate}" Visibility="{Binding Certificate, Converter={StaticResource VisibleIf}}" />
                                                <TextBox Style="{StaticResource SelectableText}" Margin="80,4,0,0" FontSize="11.5" Text="{Binding Facts, Mode=OneWay}"
                                                         Visibility="{Binding DataContext.Workspace.IsAdvanced, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource H3}" Text="Issues on this device" Margin="0,18,0,8" />
                            <ItemsControl ItemsSource="{Binding Findings}" Style="{StaticResource PlainList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Style="{StaticResource SevBadge}" Width="96"><TextBlock Text="{Binding SeverityText}" /></Border>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="8,0,0,0" MaxWidth="280" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Open these issues" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Command="{Binding DataContext.ShowFindingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
