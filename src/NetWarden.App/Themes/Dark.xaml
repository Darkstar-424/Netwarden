<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- NetWarden dark theme. All controls use these keys through DynamicResource. -->
    <Color x:Key="Color.Window">#202020</Color>
    <Color x:Key="Color.TitleBar">#1C1C1C</Color>
    <Color x:Key="Color.Nav">#202020</Color>
    <Color x:Key="Color.NavSelected">#2D3540</Color>
    <Color x:Key="Color.NavHover">#2A2A2A</Color>
    <Color x:Key="Color.Surface">#2B2B2B</Color>
    <Color x:Key="Color.SurfaceAlt">#262626</Color>
    <Color x:Key="Color.Code">#1E1E1E</Color>
    <Color x:Key="Color.Border">#3A3A3A</Color>
    <Color x:Key="Color.BorderStrong">#505050</Color>
    <Color x:Key="Color.InputBorder">#6E6E6E</Color>
    <Color x:Key="Color.Text">#F3F3F3</Color>
    <Color x:Key="Color.TextSecondary">#B5B5B5</Color>
    <Color x:Key="Color.TextDisabled">#7A7A7A</Color>
    <Color x:Key="Color.Accent">#4CC2FF</Color>
    <Color x:Key="Color.AccentHover">#62CDFF</Color>
    <Color x:Key="Color.AccentPressed">#3AA8E0</Color>
    <Color x:Key="Color.AccentText">#000000</Color>
    <Color x:Key="Color.Link">#4CC2FF</Color>
    <Color x:Key="Color.Hover">#333333</Color>
    <Color x:Key="Color.Selection">#26394D</Color>
    <Color x:Key="Color.SegmentBg">#2E2E2E</Color>
    <Color x:Key="Color.SegmentOn">#454545</Color>
    <Color x:Key="Color.Sev.Critical.Bg">#442726</Color>
    <Color x:Key="Color.Sev.Critical.Fg">#FF99A4</Color>
    <Color x:Key="Color.Sev.High.Bg">#4A2E1A</Color>
    <Color x:Key="Color.Sev.High.Fg">#FFB27A</Color>
    <Color x:Key="Color.Sev.Medium.Bg">#433519</Color>
    <Color x:Key="Color.Sev.Medium.Fg">#F2CC6B</Color>
    <Color x:Key="Color.Sev.Low.Bg">#1E3550</Color>
    <Color x:Key="Color.Sev.Low.Fg">#8CC4FF</Color>
    <Color x:Key="Color.Sev.Info.Bg">#333333</Color>
    <Color x:Key="Color.Sev.Info.Fg">#C8C8C8</Color>
