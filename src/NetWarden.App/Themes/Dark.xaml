    <Color x:Key="Color.Kev.Bg">#F3F3F3</Color>
    <Color x:Key="Color.Kev.Fg">#1B1B1B</Color>
    <Color x:Key="Color.Success">#6CCB5F</Color>
    <Color x:Key="Color.Success.Bg">#203A1E</Color>
    <Color x:Key="Color.Warning.Bg">#433519</Color>
    <Color x:Key="Color.Warning.Border">#7A6020</Color>
    <Color x:Key="Color.Warning.Fg">#F2CC6B</Color>
    <Color x:Key="Color.Danger">#FF99A4</Color>
    <Color x:Key="Color.Bar">#4A6A8F</Color>
    <Color x:Key="Color.ScrollThumb">#5A5A5A</Color>
    <Color x:Key="Color.ScrollThumbHover">#7A7A7A</Color>
    <Color x:Key="Color.MapLine">#505050</Color>
    <Color x:Key="Color.MapHub">#4CC2FF</Color>
    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="{StaticResource Color.TitleBar}" />
