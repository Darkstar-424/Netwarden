<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- NetWarden light theme. All controls use these keys through DynamicResource. -->
    <Color x:Key="Color.Window">#F3F3F3</Color>
    <Color x:Key="Color.TitleBar">#EAEEF3</Color>
    <Color x:Key="Color.Nav">#F3F3F3</Color>
    <Color x:Key="Color.NavSelected">#E3E8EF</Color>
    <Color x:Key="Color.NavHover">#EAEAEA</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#F7F8FA</Color>
    <Color x:Key="Color.Code">#F4F5F7</Color>
    <Color x:Key="Color.Border">#E0E0E0</Color>
    <Color x:Key="Color.BorderStrong">#C8CCD2</Color>
    <Color x:Key="Color.InputBorder">#8A8F96</Color>
    <Color x:Key="Color.Text">#1B1B1B</Color>
