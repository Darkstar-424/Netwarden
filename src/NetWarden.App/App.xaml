<Application x:Class="NetWarden.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NetWarden.App.Controls"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the colour theme; ThemeManager swaps it at runtime. -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <c:InverseBoolConverter x:Key="InverseBool" />
            <c:HasValueToVisibilityConverter x:Key="VisibleIf" />
            <c:HasValueToVisibilityConverter x:Key="CollapsedIf" Invert="True" />
            <c:NumberedLinesConverter x:Key="NumberedLines" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
