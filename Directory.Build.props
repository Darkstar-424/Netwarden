<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.2</Version>
    <Company>NetWarden</Company>
    <Product>NetWarden</Product>
    <Copyright>NetWarden contributors</Copyright>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CA1416;CS1591</NoWarn>
  </PropertyGroup>
</Project>
